' ROW CLASSIFICATION  (which rows of a coverage book are ours, and what they are)
' =============================================================================


' The Resumo swap rows are the ones whose column A carries the desk's
' MONTH(EDATE(..)) roll formula.
Private Function IsResumoSwapRow(ByVal formulaText As String) As Boolean
    IsResumoSwapRow = (InStr(1, UCase$(formulaText), "MONTH(EDATE(", vbTextCompare) > 0)
End Function


' The accounting classification this desk hedges under.  Written tolerantly
' because the two books spell it differently: "HtC&S", "HTC & S", "HtCS".
Private Function IsHtCSCoveragePortfolio(ByVal v As Variant) As Boolean

    Dim s As String

    s = UCase$(CleanText(v))
    s = Replace(s, " ", "")
    s = Replace(s, ".", "")
    s = Replace(s, "-", "")
    s = Replace(s, "_", "")
    s = Replace(s, "&AMP;", "&")
    s = Replace(s, "AND", "&")

    IsHtCSCoveragePortfolio = _
        (InStr(1, s, "HTC&S", vbTextCompare) > 0) Or _
        (InStr(1, s, "HTCS", vbTextCompare) > 0)

End Function


Private Function IsAlphanumericLabel(ByVal s As String) As Boolean

    Dim i As Long

    s = CleanText(s)
    If Len(s) = 0 Then Exit Function

    For i = 1 To Len(s)
        If Mid$(s, i, 1) Like "[A-Za-z0-9]" Then
            IsAlphanumericLabel = True
            Exit Function
        End If
    Next i

End Function


Private Function IsCoverageFutureRow( _
    ByVal valueA As String, _
    ByVal formulaA As String, _
    ByVal typeH As String) As Boolean

    valueA = CleanText(valueA)

    If Len(valueA) = 0 Then Exit Function
    If IsResumoSwapRow(CleanText(formulaA)) Then Exit Function
    If UCase$(CleanText(typeH)) = "PLAIN VANILLA SWAP" Then Exit Function

    IsCoverageFutureRow = IsAlphanumericLabel(valueA)

End Function


' True when a coverage instrument label describes a swap rather than a future.
' A swap sent to Bloomberg as a contract code comes back #N/A, so it must not
' become a futures row.
Private Function IsCoverageSwapTypeLabel(ByVal v As Variant) As Boolean

    Dim s As String

    s = UCase$(CleanText(v))

    IsCoverageSwapTypeLabel = _
        (InStr(1, s, "SWAP", vbTextCompare) > 0) Or _
        (InStr(1, s, "IRS", vbTextCompare) > 0)

End Function


' "OE1 #163" -> "OE";  "RX1 #164" -> "RX";  "OAT1 #165" -> "OAT".
Private Function FutureCodeFromCoverageLabel(ByVal futureLabel As String) As String

    Dim s As String
    Dim firstToken As String

    s = CleanText(futureLabel)
    If Len(s) = 0 Then Exit Function

    firstToken = Split(s, " ")(0)

    Do While Len(firstToken) > 0 And Right$(firstToken, 1) Like "[0-9]"
        firstToken = Left$(firstToken, Len(firstToken) - 1)
    Loop

    FutureCodeFromCoverageLabel = firstToken

End Function


Private Function SwapIdToBBGSecurity(ByVal rawId As Variant) As String

    Dim s As String

    s = CleanText(rawId)

    If Len(s) = 0 Then
        SwapIdToBBGSecurity = ""
    ElseIf InStr(1, UCase$(s), " CORP", vbTextCompare) > 0 Then
        SwapIdToBBGSecurity = s
    Else
        SwapIdToBBGSecurity = s & " Corp"
    End If

End Function


' The desk writes notionals as numbers, as "25MM", or as "25 M EUR".
Private Function CoverageNotionalValue(ByVal v As Variant) As Variant

    Dim s As String
    Dim n As Double

    If IsError(v) Then Exit Function
    If IsNumeric(v) Then
        CoverageNotionalValue = CDbl(v)
        Exit Function
    End If

    s = UCase$(CleanText(v))
    If Len(s) = 0 Then
        CoverageNotionalValue = ""
        Exit Function
    End If

    s = Replace(s, "EUR", "")
    s = Replace(s, "USD", "")
    s = Replace(s, "GBP", "")
    s = Replace(s, ChrW$(8364), "")      ' the euro sign, whatever the code page
    s = Replace(s, " ", "")

    If InStr(1, s, "MM", vbTextCompare) > 0 Then
        n = val(Replace(Replace(s, "MM", ""), ",", "."))
        CoverageNotionalValue = n * 1000000#
        Exit Function
    End If

    If Right$(s, 1) = "M" Then
        n = val(Replace(Left$(s, Len(s) - 1), ",", "."))
        CoverageNotionalValue = n * 1000000#
        Exit Function
    End If

    CoverageNotionalValue = CDblSafe(v)

End Function


Private Function HasAnySwapId( _
    ByVal directId As String, _
    ByVal fixedId As String, _
    ByVal floatId As String) As Boolean

    HasAnySwapId = (Len(directId) > 0 Or Len(fixedId) > 0 Or Len(floatId) > 0)

End Function


' =============================================================================
' BUILDING THE TWO MAPS
'
' Both map sheets are filled from a staged array and written in ONE assignment.
' Cell-by-cell writing was not just slow: with a few hundred rows x fifteen
' columns it is thousands of round trips into Excel, which is what made the
' button look like it had hung.
' =============================================================================


' SwapMap, from Hedge Risco Tx Juro.  Plain-vanilla and synthetic swaps are two
' groups of columns on the SAME source row, so one row can produce two mapping
' rows.
Private Function BuildSwapMapFromCoverageSupport( _
    ByVal rcByRow As Object, _
    ByVal rcIndex As Object) As Long

    Dim wsCov As Worksheet
    Dim wsMap As Worksheet
    Dim r As Long
    Dim n As Long
    Dim buf As Variant
    Dim colCount As Long

    Dim formulaA As String
    Dim rcKey As String
    Dim rowIsin As String
    Dim linkedISIN As String
    Dim linkSource As String
    Dim statusText As String
    Dim directId As String
    Dim fixedId As String
    Dim floatId As String
    Dim counterparty As String
    Dim ccy As String
    Dim startDate As Variant

    Set wsCov = EnsureCoverageSupportSheet()
    Set wsMap = EnsureSwapMapSheet()

    colCount = colNum(SMCOL_LINK_SOURCE)

    ' Two mapping rows per source row is the worst case.
    ReDim buf(1 To (SWAP_ID_LAST_ROW - SWAP_ID_FIRST_ROW + 1) * 2, 1 To colCount)

    For r = SWAP_ID_FIRST_ROW To SWAP_ID_LAST_ROW

        If IsHtCSCoveragePortfolio( _
            wsCov.Cells(r, HEDGE_RISCO_PORTFOLIO_TYPE_COL).value) Then

            formulaA = CleanText(wsCov.Cells(r, HEDGE_RISCO_FORMULA_A_COL).value)
            If Len(formulaA) = 0 Then
                formulaA = CleanText(wsCov.Cells(r, "A").value)
            End If

            If IsResumoSwapRow(formulaA) Then

                rcKey = ""
                If rcByRow.Exists(r) Then rcKey = CStr(rcByRow(r))

                rowIsin = CleanText(wsCov.Cells(r, RTJ_ISIN_COL).value)
                linkedISIN = ResolveCoveredBond(rcIndex, rcKey, rowIsin, linkSource)

                counterparty = CleanText(wsCov.Cells(r, RTJ_CPTY_COL).value)
                ccy = CleanText(wsCov.Cells(r, RTJ_CCY_COL).value)
                startDate = wsCov.Cells(r, RTJ_STARTDATE_COL).value

                If Len(linkedISIN) = 0 Then
                    statusText = "No covered bond for coverage relation " & rcKey
                Else
                    statusText = "OK"
                End If

                ' --- plain vanilla: ids I/J/K, notional O, end date Q --------
                directId = SwapIdToBBGSecurity(wsCov.Cells(r, RTJ_PLAIN_DIRECT_COL).value)
                fixedId = SwapIdToBBGSecurity(wsCov.Cells(r, RTJ_PLAIN_FIXED_COL).value)
                floatId = SwapIdToBBGSecurity(wsCov.Cells(r, RTJ_PLAIN_FLOAT_COL).value)

                If HasAnySwapId(directId, fixedId, floatId) Then
                    n = n + 1
                    FillSwapMapRow buf, n, r, rcKey, linkedISIN, linkSource, _
                        "PLAIN", directId, fixedId, floatId, statusText, _
                        counterparty, _
                        CoverageNotionalValue(wsCov.Cells(r, RTJ_NOTIONAL_COL).value), _
                        startDate, _
                        wsCov.Cells(r, RTJ_ENDDATE_COL).value, _
                        ccy, "PLAIN_O"
                End If

                ' --- synthetic: ids AC/AD/AE, notional AF, end date AI -------
                directId = SwapIdToBBGSecurity(wsCov.Cells(r, RTJ_SYNTH_DIRECT_COL).value)
                fixedId = SwapIdToBBGSecurity(wsCov.Cells(r, RTJ_SYNTH_FIXED_COL).value)
                floatId = SwapIdToBBGSecurity(wsCov.Cells(r, RTJ_SYNTH_FLOAT_COL).value)

                If HasAnySwapId(directId, fixedId, floatId) Then
                    n = n + 1
                    FillSwapMapRow buf, n, r, rcKey, linkedISIN, linkSource, _
                        "SYNTHETIC", directId, fixedId, floatId, statusText, _
                        counterparty, _
                        CoverageNotionalValue(wsCov.Cells(r, RTJ_SYNTH_NOTIONAL_COL).value), _
                        startDate, _
                        wsCov.Cells(r, RTJ_SYNTH_ENDDATE_COL).value, _
                        ccy, "SYNTHETIC_AF"
                End If

            End If

        End If

    Next r

    WriteMapBlock wsMap, buf, n, colCount, SMCOL_SOURCEROW, SMCOL_LINK_SOURCE

    BuildSwapMapFromCoverageSupport = n

End Function


Private Sub FillSwapMapRow( _
    ByRef buf As Variant, _
    ByVal n As Long, _
    ByVal sourceRow As Long, _
    ByVal rcKey As String, _
    ByVal linkedISIN As String, _
    ByVal linkSource As String, _
    ByVal idSource As String, _
    ByVal directId As String, _
    ByVal fixedId As String, _
    ByVal floatId As String, _
