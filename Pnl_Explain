' =============================================================================
' COVERAGE RELATION (#RC) -> BOND
'
' THE CORRECTION THIS MODULE EXISTS FOR
'
' A coverage relation - the desk writes it "#RC" - is the unit of hedging in
' both Hedge Risco books.  One #RC ties ONE covered element (a bond, named by
' ISIN) to one or more coverage instruments (futures, swaps).
'
' In both books the covered element is written ONCE, on the row that opens the
' group.  The rows underneath carry only the instrument: their ISIN cell is
' blank, and in Hedge Risco Total their #RC cell is blank too, because the file
' is read by a human who can see the group.
'
' The old code carried the #RC onto every Futures row and then ignored it: the
' bond was taken from the instrument row's OWN ISIN cell.  On the first row of
' a group that works.  On every continuation row the cell is empty, so the row
' was stamped "Missing LinkedISIN", never linked to a bond, and its risk and
' PnL disappeared from the attribution - which then read the bond as under- or
' un-hedged and picked the wrong spread framework for it.
'
' The relation is the join.  So:
'
'   1) walk each book once and FORWARD-FILL the #RC down its group, resetting
'      at a genuinely blank row so a fill cannot leak into the next group;
'   2) register #RC -> ISIN from the rows that DO carry an ISIN;
'   3) resolve every instrument row's bond through its #RC, falling back to the
'      row's own ISIN only when the relation has no registered bond.
'
' TWO LAYOUTS, TWO INDEXES
'
' The books do not share a layout - the #RC is in column B in one and column A
' in the other, the covered ISIN in C and in B - so each has its own scan with
' its own column constants.  They also do not share a NUMBERING: "#RC 12" in
' Tx Juro is a different relation from "#RC 12" in Total.  Merging the two into
' one index would attach the wrong bond to a hedge whenever both books happened
' to use the same number, so each book gets its own Dictionary and the two are
' never consulted together.
'
' Every resolution records HOW it was reached (LINK_SRC_*) on the map sheet and
' on the hedge row, so a wrong link is visible rather than inferred.
' =============================================================================


' The desk writes a relation as "#163", "163", " 163 " or, when the cell is a
' link into another sheet, as whatever that link returns.  All of those are the
' same relation and must hash to the same key.
Private Function NormalizeCoverageRelation(ByVal v As Variant) As String

    Dim s As String

    s = CleanText(v)
    If Len(s) = 0 Then Exit Function

    Do While Len(s) > 0 And Left$(s, 1) = "#"
        s = Trim$(Mid$(s, 2))
    Loop

    ' A relation that is a plain number must not depend on how Excel typed the
    ' cell: 163, 163.0 and "163" are one relation.
    If IsNumeric(s) Then
        If CDbl(s) = Int(CDbl(s)) Then
            NormalizeCoverageRelation = Format$(CDbl(s), "0")
            Exit Function
        End If
    End If

    Do While InStr(s, "  ") > 0
        s = Replace(s, "  ", " ")
    Loop

    NormalizeCoverageRelation = UCase$(s)

End Function


' True when a row carries nothing at all, so the #RC fill must stop there
' rather than run on into the next group.
Private Function CoverageRowIsBlank( _
    ByVal ws As Worksheet, _
    ByVal r As Long, _
    ByVal lastCol As String) As Boolean

    Dim c As Long
    Dim lastN As Long

    lastN = colNum(lastCol)

    For c = 1 To lastN
        If Len(CleanText(ws.Cells(r, c).value)) > 0 Then
            CoverageRowIsBlank = False
            Exit Function
        End If
    Next c

    CoverageRowIsBlank = True

End Function


' One step of the fill, as a pure decision so it can be tested away from a
' worksheet.  Returns the relation the row belongs to:
'
'   a blank row      ""       the fill STOPS - a wholly empty row separates
'                             groups in both books, and carrying on past it is
'                             what would credit the last hedge of one relation
'                             to the next bond down the sheet
'   a row with an #RC  that #RC   a new group starts
'   anything else    `current`    a continuation row inherits its group
Private Function NextCoverageRelation( _
    ByVal current As String, _
    ByVal rawRc As String, _
    ByVal rowIsBlank As Boolean) As String

    If rowIsBlank Then Exit Function

    If Len(rawRc) > 0 Then
        NextCoverageRelation = rawRc
    Else
        NextCoverageRelation = current
    End If

End Function


' Forward-filled #RC for every row of one book, as a Dictionary of row -> key.
'
' Separate from the index below because two different passes over the same book
' (swaps and futures in Tx Juro) must see the SAME fill; recomputing it in each
' would be two chances to disagree.
Private Function BuildCoverageRelationByRow( _
    ByVal ws As Worksheet, _
    ByVal firstRow As Long, _
    ByVal lastRow As Long, _
    ByVal rcCol As String, _
    ByVal formulaCol As String, _
    ByVal lastCol As String) As Object

    Dim d As Object
    Dim r As Long
    Dim current As String
    Dim raw As String

    Set d = CreateObject("Scripting.Dictionary")

    For r = firstRow To lastRow

        raw = NormalizeCoverageRelation(ws.Cells(r, rcCol).value)

        ' The relation is often a link into another sheet, so when the cell
        ' shows nothing the stored formula text is the only record of which
        ' relation the row belongs to.
        If Len(raw) = 0 And Len(formulaCol) > 0 Then
            raw = NormalizeCoverageRelation(ws.Cells(r, formulaCol).value)
        End If

        current = NextCoverageRelation( _
            current, raw, CoverageRowIsBlank(ws, r, lastCol))

        d(r) = current

    Next r

    Set BuildCoverageRelationByRow = d

End Function


' #RC -> the ISIN that relation covers, for ONE book.
'
' A relation naming two different ISINs is a data fault, not something to pick
' a winner for: it is stored as RC_AMBIGUOUS so every row under it falls back
' to its own ISIN and says so, rather than half the hedges silently landing on
' the wrong bond.
Private Function BuildCoverageRelationIndex( _
    ByVal ws As Worksheet, _
    ByVal firstRow As Long, _
    ByVal lastRow As Long, _
    ByVal isinCol As String, _
    ByVal rcByRow As Object) As Object

    Dim d As Object
    Dim r As Long
    Dim rc As String
    Dim isin As String

    Set d = CreateObject("Scripting.Dictionary")

    For r = firstRow To lastRow

        rc = ""
        If rcByRow.Exists(r) Then rc = CStr(rcByRow(r))

        isin = UCase$(CleanText(ws.Cells(r, isinCol).value))

        If Len(rc) > 0 And Len(isin) > 0 Then

            If Not d.Exists(rc) Then
                d.Add rc, isin
            ElseIf d(rc) <> isin Then
                d(rc) = RC_AMBIGUOUS
            End If

        End If

    Next r

    Set BuildCoverageRelationIndex = d

End Function


' The bond a coverage instrument row hedges.
'
' `linkSource` comes back saying which route was taken, so the desk can tell a
' relation-resolved link from a row-resolved one without re-reading the source
' book.
Private Function ResolveCoveredBond( _
    ByVal rcIndex As Object, _
    ByVal rcKey As String, _
    ByVal rowIsin As String, _
    ByRef linkSource As String) As String

    Dim viaRc As String

    If Len(rcKey) > 0 Then
        If rcIndex.Exists(rcKey) Then viaRc = CStr(rcIndex(rcKey))
    End If

    ResolveCoveredBond = ResolveCoveredBondFrom(viaRc, rowIsin, linkSource)

End Function


' The decision itself, with the lookup already done.
'
' Split from the Dictionary access above so the rule can be exercised directly:
' this is the whole of the correction, and "the relation wins" is a claim worth
' being able to prove rather than read.
Private Function ResolveCoveredBondFrom( _
    ByVal viaRc As String, _
    ByVal rowIsin As String, _
    ByRef linkSource As String) As String

    rowIsin = UCase$(CleanText(rowIsin))

    If Len(viaRc) > 0 And viaRc <> RC_AMBIGUOUS Then

        ResolveCoveredBondFrom = viaRc

        If Len(rowIsin) = 0 Then
            linkSource = LINK_SRC_RC
        ElseIf rowIsin = viaRc Then
            linkSource = LINK_SRC_RC_AGREE
        Else
            ' The relation wins.  A continuation row that carries a stale or
            ' mistyped ISIN is exactly the case this correction is for.
            linkSource = LINK_SRC_RC_WINS
        End If

        Exit Function

    End If

    If viaRc = RC_AMBIGUOUS Then
        ResolveCoveredBondFrom = rowIsin
        If Len(rowIsin) > 0 Then
            linkSource = LINK_SRC_AMBIGUOUS
        Else
            linkSource = LINK_SRC_NONE
        End If
        Exit Function
    End If

    ResolveCoveredBondFrom = rowIsin

    If Len(rowIsin) > 0 Then
        linkSource = LINK_SRC_ROW
    Else
        linkSource = LINK_SRC_NONE
    End If

End Function


' =============================================================================
' BOND <-> HEDGE LINKING   (Bonds!BR SwapLink, Bonds!BS FutLink)
'
' These two columns are how the desk reads, on the bond row itself, which
' hedges cover it.  They are the visible half of the coverage relationship, so
' they have to keep working exactly as before - only now the ISIN they are
' keyed on is the one the #RC resolved, which means the continuation rows that
' used to be dropped now appear here too.
'
' The old implementation scanned every bond row for every hedge - a few hundred
' hedges against a few hundred bonds is over a hundred thousand cell reads,
' each hit also writing a NumberFormat.  It is now one pass to index the bonds
' by ISIN, an in-memory accumulation, and one write per bond row that actually
' gained a link.
' =============================================================================


' Index the bonds by ISIN and clear the two link columns.  Call once, before
' any hedge row is mapped.
Private Sub BeginBondLinks(ByVal wsBnd As Worksheet)

    Dim lastRow As Long
    Dim r As Long
    Dim isin As String
    Dim vals As Variant

    Set mBondRowsByIsin = CreateObject("Scripting.Dictionary")
    Set mSwapLinkByRow = CreateObject("Scripting.Dictionary")
    Set mFutLinkByRow = CreateObject("Scripting.Dictionary")

    lastRow = LastBondDataRow(wsBnd)
    If lastRow < BOND_DATA_ROW Then Exit Sub

    ' One read for the whole ISIN column rather than one per row.
    vals = wsBnd.Range(BCOL_ISIN & BOND_DATA_ROW & ":" & BCOL_ISIN & lastRow).value

    For r = BOND_DATA_ROW To lastRow

        If lastRow = BOND_DATA_ROW Then
            isin = UCase$(CleanText(vals))
        Else
            isin = UCase$(CleanText(vals(r - BOND_DATA_ROW + 1, 1)))
        End If

        If Len(isin) > 0 Then
            ' The same ISIN can sit on several bond rows (one bond in two
            ' portfolios).  Every one of them gets the link.
            If mBondRowsByIsin.Exists(isin) Then
                mBondRowsByIsin(isin) = mBondRowsByIsin(isin) & "," & CStr(r)
            Else
                mBondRowsByIsin.Add isin, CStr(r)
            End If
        End If

    Next r

    ' Contents only.  Clearing formats here would take the desk's own
    ' highlighting off the two columns every time the button ran.
    wsBnd.Range(BCOL_SWAPLINK & BOND_DATA_ROW & ":" & _
                BCOL_FUTLINK & lastRow).ClearContents

End Sub


' Queue one hedge against one bond.  `isFuture` picks the column.
Private Sub QueueBondLink( _
    ByVal isin As String, _
    ByVal hedgeId As String, _
    ByVal isFuture As Boolean)

    Dim cleanISIN As String
    Dim cleanId As String
    Dim rows As Variant
    Dim i As Long
    Dim r As Long
    Dim target As Object

    If mBondRowsByIsin Is Nothing Then Exit Sub

    cleanISIN = UCase$(CleanText(isin))
    cleanId = IdText(hedgeId)

    If Len(cleanISIN) = 0 Then Exit Sub
    If Len(cleanId) = 0 Then Exit Sub
    If Not mBondRowsByIsin.Exists(cleanISIN) Then Exit Sub

    If isFuture Then
        Set target = mFutLinkByRow
    Else
        Set target = mSwapLinkByRow
    End If

    rows = Split(CStr(mBondRowsByIsin(cleanISIN)), ",")

    For i = LBound(rows) To UBound(rows)

        r = CLng(rows(i))

        If target.Exists(r) Then
            target(r) = AppendCsv(CStr(target(r)), cleanId)
        Else
            target.Add r, cleanId
        End If

    Next i

End Sub


' Write the accumulated links.  One cell write per bond row that gained one.
Private Sub FlushBondLinks(ByVal wsBnd As Worksheet)

    Dim k As Variant

    If mSwapLinkByRow Is Nothing Then Exit Sub

    For Each k In mSwapLinkByRow.keys
        wsBnd.Cells(CLng(k), colNum(BCOL_SWAPLINK)).value = _
            TextSafe(CStr(mSwapLinkByRow(k)))
    Next k

    For Each k In mFutLinkByRow.keys
        wsBnd.Cells(CLng(k), colNum(BCOL_FUTLINK)).value = _
            TextSafe(CStr(mFutLinkByRow(k)))
    Next k

End Sub


' How many bond rows ended up carrying a link of each kind.  Reported in the
' completion box: "22 futures rows loaded" and "0 bonds linked" are very
' different outcomes and used to look identical.
Private Function BondLinkCount(ByVal isFuture As Boolean) As Long

    If isFuture Then
        If mFutLinkByRow Is Nothing Then Exit Function
        BondLinkCount = mFutLinkByRow.Count
    Else
        If mSwapLinkByRow Is Nothing Then Exit Function
        BondLinkCount = mSwapLinkByRow.Count
    End If

End Function


Private Function AppendCsv(ByVal existing As String, ByVal item As String) As String

    Dim e As String
    Dim x As String

    e = CleanText(existing)
    x = IdText(item)

    If x = "" Then
        AppendCsv = e
        Exit Function
    End If

    If e = "" Then
        AppendCsv = x
    ElseIf InStr(1, "," & e & ",", "," & x & ",", vbTextCompare) = 0 Then
        AppendCsv = e & "," & x
    Else
        AppendCsv = e
    End If

End Function


' =============================================================================
' TEXT-SAFE IDENTIFIERS  -  the replacement for blanket NumberFormat = "@"
'
' Long identifiers must not be turned into numbers: Excel would show a swap id
' as 1.23457E+14 and, worse, round away its last digits.  The old fix was to
' format whole columns as text, which is what pushed the sheets' UsedRange to
' row 50,004 and made every subsequent clear a 50,000-row operation.
'
' A leading apostrophe does the same job per value.  It is a display prefix,
' not part of the cell's value - reading the cell back gives the id unchanged -
' and it changes no cell format at all.  Applied only when the id would
' otherwise be read as a number, so ISINs and contract labels are written
' exactly as they are.
' =============================================================================
Private Function TextSafe(ByVal s As String) As String

    If Len(s) = 0 Then Exit Function

    If IsNumeric(s) Then
        TextSafe = "'" & s
    Else
        TextSafe = s
    End If

End Function


' =============================================================================
' RepairStaleTextFormats used to live here.
'
' It reset NumberFormat to "General" on the blank rows below the data, to undo
' the blanket text formatting an older build had left on tens of thousands of
' empty cells.  Removed: it is the only thing in this module that wrote a cell
' FORMAT, and this module does not write formats.
'
' The damage it repaired is real but it is a ONE-OFF, not something a load
' should redo on every run.  To clear it by hand, once: select the blank rows
' below the data on Swaps columns A, L and AN:AP, and set Format > General.
' Save, close and reopen, and Excel recomputes UsedRange down to the real data.
' =============================================================================


' =============================================================================
' SUPPORT SHEETS
'
' Three scratch sheets: two temporary copies of the coverage books, and the two
' maps built from them.  Headers are written ONLY into cells that are empty, so
' re-running the load never overwrites a label the desk retitled, and no font,
' colour or alignment is applied to any of them.
' =============================================================================


Private Function GetOrAddSheet(ByVal sheetName As String) As Worksheet

    Dim ws As Worksheet

    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets(sheetName)
    On Error GoTo 0

    If ws Is Nothing Then
        Set ws = ThisWorkbook.Worksheets.Add( _
            After:=ThisWorkbook.Worksheets(ThisWorkbook.Worksheets.Count))
        ws.Name = sheetName
    End If

    Set GetOrAddSheet = ws

End Function


' Write a header label only where there is not one already.
'
' The old SetupFuturesFinalHeaders / SetupSwapsFinalHeaders wrote the whole
' header row on every run and then set Font.Bold and HorizontalAlignment across
' it.  That is the "de-formats the file" complaint: a load is not the place to
' restate the desk's own formatting, and an Array() assignment across a span
' also silently pads with #N/A when the array and the span disagree.  One cell
' at a time, only when blank, no formatting.
Private Sub SetHeaderIfBlank( _
    ByVal ws As Worksheet, _
    ByVal col As String, _
    ByVal headerRow As Long, _
    ByVal label As String)

    If Len(CleanText(ws.Cells(headerRow, colNum(col)).value)) = 0 Then
        ws.Cells(headerRow, colNum(col)).value = label
    End If

End Sub


' =============================================================================
' HEADER ASSERTION  -  the macro CHECKS row 4, it does not write it
'
' This used to be EnsureHedgeSheetHeaders, which wrote a label into any header
' cell it found empty.  Two problems with that, and the second is the reason
' every hedge read as zero for as long as it did:
'
'   The header row is the desk's, not the macro's.  Filling a blank is a small
'   liberty, but it is still the load rewriting a label row it does not own.
'
'   More importantly it made the WRONG layout invisible.  When this module's
'   column constants drifted ten places from the sheet, writing headers into
'   the columns it believed in produced a Futures sheet with "Hedge_Source"
'   sitting over Coverage_BPV and everything still looking populated.  Nothing
'   failed.  The SUMIFS behind the attribution simply matched nothing, and a
'   fully hedged book reported as unhedged.
'
' So the direction is reversed.  Row 4 is now READ and compared against the
' layout this module compiles against, and a disagreement stops the run BEFORE
' a single cell is written - naming the sheet, the column letter, what was
' expected and what is actually there.  A layout change is then a message, not
' a silent zero.
'
' Comparison is case-insensitive and ignores surrounding whitespace, so
' retitling for readability is fine; only a genuinely different column is a
' failure.
' =============================================================================


' Returns "" when both sheets match, otherwise a description of every column
' that does not.
Private Function AssertHedgeSheetHeaders( _
    ByVal wsFut As Worksheet, _
    ByVal wsSw As Worksheet) As String

    Dim bad As String

    bad = HeaderMismatches(wsFut, SH_FUTURES, FUT_HEADER_ROW, ExpectedFuturesHeaders())
    bad = bad & HeaderMismatches(wsSw, SH_SWAPS, SWAP_HEADER_ROW, ExpectedSwapHeaders())

    If Len(bad) = 0 Then Exit Function

    AssertHedgeSheetHeaders = _
        "The hedge sheets are not laid out the way this macro expects, so " & _
        "nothing was loaded." & vbCrLf & vbCrLf & _
        "Every column below is read or written by name.  Loading against a " & _
        "shifted layout writes hedge data on top of market data and makes " & _
        "every hedge sum to zero, which is why the run stops here instead." & _
        vbCrLf & vbCrLf & bad & vbCrLf & _
        "Fix the header row, or tell the desk's developer which columns moved."

End Function


Private Function HeaderMismatches( _
    ByVal ws As Worksheet, _
    ByVal sheetName As String, _
    ByVal headerRow As Long, _
    ByVal expected As Variant) As String

    Dim i As Long
    Dim actual As String
    Dim want As String
    Dim out As String

    For i = LBound(expected) To UBound(expected)

        want = CStr(expected(i))

        If Len(want) > 0 Then

            actual = LCase$(Trim$(CleanText(ws.Cells(headerRow, i + 1).value)))

            If actual <> LCase$(want) Then

                out = out & "  " & sheetName & "!" & _
                      ColLetterFromNumber(i + 1) & headerRow & _
                      "  expected """ & want & """"

                If Len(actual) = 0 Then
                    out = out & ", found it empty" & vbCrLf
                Else
                    out = out & ", found """ & _
                          CleanText(ws.Cells(headerRow, i + 1).value) & """" & vbCrLf
                End If

            End If

        End If

    Next i

    HeaderMismatches = out

End Function


