' Bond link accumulation.  Bonds!SwapLink and Bonds!FutLink used to be written
' by scanning every bond row for every hedge row - several hundred thousand
' cell reads and a NumberFormat write per hit.  The links are now accumulated
' in memory against a one-pass ISIN index and written once per touched row.
' =============================================================================
Private mBondRowsByIsin As Object    ' ISIN -> "row,row,..."
Private mSwapLinkByRow As Object     ' bond row -> CSV of swap ids
Private mFutLinkByRow As Object      ' bond row -> CSV of contract labels

' Swaps whose floating curve could not be resolved.  Reported at the end: these
