' CoverageFutures, from Hedge Risco Tx Juro.
Private Function BuildCoverageFuturesMapFromCoverageSupport( _
    ByVal rcByRow As Object, _
    ByVal rcIndex As Object) As Long

    Dim wsCov As Worksheet
    Dim wsFMap As Worksheet
    Dim r As Long
    Dim n As Long
    Dim buf As Variant
    Dim colCount As Long

    Dim valueA As String
    Dim formulaA As String
    Dim typeH As String
    Dim rcKey As String
    Dim linkedISIN As String
    Dim linkSource As String
    Dim futureCode As String
    Dim contracts As Variant

    Set wsCov = EnsureCoverageSupportSheet()
    Set wsFMap = EnsureCoverageFuturesSheet()

    colCount = colNum(CFCOL_LINK_SOURCE)

    ReDim buf(1 To SWAP_ID_LAST_ROW - SWAP_ID_FIRST_ROW + 1, 1 To colCount)

    For r = SWAP_ID_FIRST_ROW To SWAP_ID_LAST_ROW

        If IsHtCSCoveragePortfolio( _
            wsCov.Cells(r, HEDGE_RISCO_PORTFOLIO_TYPE_COL).value) Then

            valueA = CleanText(wsCov.Cells(r, "A").value)
            formulaA = CleanText(wsCov.Cells(r, HEDGE_RISCO_FORMULA_A_COL).value)
            typeH = CleanText(wsCov.Cells(r, RTJ_TYPE_COL).value)

            If IsCoverageFutureRow(valueA, formulaA, typeH) Then

                rcKey = ""
                If rcByRow.Exists(r) Then rcKey = CStr(rcByRow(r))

                linkedISIN = ResolveCoveredBond( _
                    rcIndex, rcKey, _
                    CStr(wsCov.Cells(r, RTJ_ISIN_COL).value), linkSource)

                futureCode = FutureCodeFromCoverageLabel(valueA)
                contracts = CoverageNotionalValue(wsCov.Cells(r, RTJ_NOTIONAL_COL).value)

                n = n + 1

                buf(n, colNum(CFCOL_SOURCEROW)) = r
                buf(n, colNum(CFCOL_COVERAGERELATION)) = rcKey
                buf(n, colNum(CFCOL_LINKEDISIN)) = linkedISIN
                buf(n, colNum(CFCOL_COVERAGEINFO_D)) = CleanText(wsCov.Cells(r, RTJ_INFO_COL).value)
                buf(n, colNum(CFCOL_FUTURELABEL)) = valueA
                buf(n, colNum(CFCOL_FUTURECODE)) = futureCode
                buf(n, colNum(CFCOL_HEDGETYPE)) = typeH
                buf(n, colNum(CFCOL_CONTRACTS)) = contracts
                buf(n, colNum(CFCOL_STARTDATE)) = wsCov.Cells(r, RTJ_STARTDATE_COL).value
                buf(n, colNum(CFCOL_CCY)) = CleanText(wsCov.Cells(r, RTJ_CCY_COL).value)
                buf(n, colNum(CFCOL_IMPORTSTATUS)) = _
                    CoverageImportStatus(linkedISIN, futureCode, contracts, rcKey)
                buf(n, colNum(CFCOL_HEDGE_SOURCE)) = HEDGE_SOURCE_RTJ
                buf(n, colNum(CFCOL_RC_KEY)) = rcKey
                buf(n, colNum(CFCOL_LINK_SOURCE)) = linkSource

            End If

        End If

    Next r

    WriteMapBlock wsFMap, buf, n, colCount, CFCOL_SOURCEROW, CFCOL_LINK_SOURCE

    BuildCoverageFuturesMapFromCoverageSupport = n

End Function


' CoverageFutures, from Hedge Risco Total.  APPENDS underneath whatever the Tx
' Juro pass wrote: this pass ADDS a second book, it does not replace the first.
Private Function AppendCoverageFuturesMapFromCoverageTotal( _
    ByVal rcByRow As Object, _
    ByVal rcIndex As Object) As Long

    Dim wsCov As Worksheet
    Dim wsFMap As Worksheet
    Dim r As Long
    Dim n As Long
    Dim outRow As Long
    Dim buf As Variant
    Dim colCount As Long

    Dim rcKey As String
    Dim linkedISIN As String
    Dim linkSource As String
    Dim typeLabel As String
    Dim futureCode As String
    Dim contracts As Variant
    Dim statusText As String

    Set wsCov = EnsureCoverageTotalSupportSheet()
    Set wsFMap = EnsureCoverageFuturesSheet()

    colCount = colNum(CFCOL_LINK_SOURCE)

    ReDim buf(1 To HEDGE_TOTAL_LAST_ROW - HEDGE_TOTAL_FIRST_ROW + 1, 1 To colCount)

    For r = HEDGE_TOTAL_FIRST_ROW To HEDGE_TOTAL_LAST_ROW

        If IsHtCSCoveragePortfolio( _
            wsCov.Cells(r, HEDGE_TOTAL_PORTFOLIO_TYPE_COL).value) Then

            typeLabel = CleanText(wsCov.Cells(r, HEDGE_TOTAL_TYPE_COL).value)

            rcKey = ""
            If rcByRow.Exists(r) Then rcKey = CStr(rcByRow(r))

            linkedISIN = ResolveCoveredBond( _
                rcIndex, rcKey, _
                CStr(wsCov.Cells(r, RT_ISIN_COL).value), linkSource)

            contracts = CoverageNotionalValue( _
                wsCov.Cells(r, HEDGE_TOTAL_NOTIONAL_COL).value)

            ' A swap in this book must not become a futures row: it would be
            ' sent to Bloomberg as a contract code and come back #N/A.  It is
            ' still recorded, with a status saying why it was not taken, so a
            ' row is never silently absent from both sheets.
            If IsCoverageSwapTypeLabel(typeLabel) Then
                futureCode = ""
                statusText = "Swap row in Hedge Risco Total - not loaded as a future"
            Else
                futureCode = FutureCodeFromCoverageLabel(typeLabel)
                statusText = CoverageImportStatus(linkedISIN, futureCode, contracts, rcKey)
            End If

            If Len(typeLabel) > 0 Or Len(linkedISIN) > 0 Then

                n = n + 1

                buf(n, colNum(CFCOL_SOURCEROW)) = r
                buf(n, colNum(CFCOL_COVERAGERELATION)) = rcKey
                buf(n, colNum(CFCOL_LINKEDISIN)) = linkedISIN
                buf(n, colNum(CFCOL_COVERAGEINFO_D)) = _
                    CleanText(wsCov.Cells(r, HEDGE_TOTAL_COUNTERPARTY_COL).value)
                buf(n, colNum(CFCOL_FUTURELABEL)) = typeLabel
                buf(n, colNum(CFCOL_FUTURECODE)) = futureCode
                buf(n, colNum(CFCOL_HEDGETYPE)) = typeLabel
                buf(n, colNum(CFCOL_CONTRACTS)) = contracts
                buf(n, colNum(CFCOL_STARTDATE)) = _
                    wsCov.Cells(r, HEDGE_TOTAL_STARTDATE_COL).value
                buf(n, colNum(CFCOL_CCY)) = _
                    CleanText(wsCov.Cells(r, HEDGE_TOTAL_CCY_COL).value)
                buf(n, colNum(CFCOL_IMPORTSTATUS)) = statusText
                buf(n, colNum(CFCOL_HEDGE_SOURCE)) = HEDGE_SOURCE_RT
                buf(n, colNum(CFCOL_BPV)) = CDblSafe(wsCov.Cells(r, HEDGE_TOTAL_BPV_COL).value)
                buf(n, colNum(CFCOL_RC_KEY)) = rcKey
                buf(n, colNum(CFCOL_LINK_SOURCE)) = linkSource

            End If

        End If

    Next r

    If n = 0 Then Exit Function

    outRow = wsFMap.Cells(wsFMap.rows.Count, colNum(CFCOL_SOURCEROW)).End(xlUp).Row + 1
    If outRow < DATA_ROW Then outRow = DATA_ROW

    wsFMap.Range(CFCOL_SOURCEROW & outRow).Resize(n, colCount).value = buf

    AppendCoverageFuturesMapFromCoverageTotal = n

End Function


' Why a mapped row will or will not produce a usable futures position.
' Names the coverage relation when the bond could not be found, because that is
' the thing to go and look at in the source book.
Private Function CoverageImportStatus( _
    ByVal linkedISIN As String, _
    ByVal futureCode As String, _
    ByVal contracts As Variant, _
    ByVal rcKey As String) As String

    If Len(linkedISIN) = 0 Then
        If Len(rcKey) = 0 Then
            CoverageImportStatus = "No coverage relation on this row"
        Else
            CoverageImportStatus = "No covered bond for coverage relation " & rcKey
        End If
    ElseIf Len(futureCode) = 0 Then
        CoverageImportStatus = "Missing FutureCode"
    ElseIf Not IsNumeric(contracts) Then
        CoverageImportStatus = "Missing Contracts"
    Else
        CoverageImportStatus = "OK"
    End If

End Function


' Clear a map sheet's data block and write the staged rows in one assignment.
Private Sub WriteMapBlock( _
    ByVal ws As Worksheet, _
    ByRef buf As Variant, _
    ByVal n As Long, _
    ByVal colCount As Long, _
    ByVal firstCol As String, _
    ByVal lastCol As String)

    Dim lastRow As Long

    lastRow = LastRowInColumn(ws, firstCol, DATA_ROW)

    ws.Range(firstCol & DATA_ROW & ":" & lastCol & _
             CStr(SheetClearLastRow(ws, DATA_ROW, lastRow))).ClearContents

    If n > 0 Then
        ws.Range(firstCol & DATA_ROW).Resize(n, colCount).value = buf
    End If

End Sub


' =============================================================================
' POPULATING THE FUTURES AND SWAPS SHEETS
'
' Both are staged into an array and written in one assignment, and both stamp
' the bond link as they go.  The bond link now uses the ISIN the COVERAGE
' RELATION resolved, which is the whole point of the correction: a continuation
' row of a relation carries no ISIN of its own, so under the old ISIN-only rule
' it reached neither the Futures sheet's LinkedISIN nor Bonds!FutLink.
'
' The staging array is sized for the WORST case - every map row producing a
' position - and the write asks for only the `n` rows that did.  Excel discards
' the rest: assigning an array larger than its target range writes the
' top-left block and drops the remainder.  Nothing beyond row `n` is touched,
' and the clear above has already emptied it.
' =============================================================================


' =============================================================================
' COLUMN OWNERSHIP
'
' The single most damaging thing this module used to do.
'
' Both append routines built a buffer as wide as the whole sheet, ClearContents
' across that whole width, and then wrote the buffer back in one shot.  The
' buffer only ever had values in the mapping columns, so every OTHER cell in
' the block - every BDP, every BQL, every model formula on Futures and on
' Swaps - was overwritten with an empty variant.  The load destroyed the sheet
' it was loading into, on every single run.
'
' It went unnoticed because the old three-button order rewrote all those
' formulas immediately afterwards.  Nothing does that any more.
'
' So the module now declares exactly which columns it owns.  It clears those
' columns and writes those columns.  Every other column on Futures and Swaps is
' out of bounds - it belongs to the formulas the desk put there.
' =============================================================================


' Futures columns this module writes.  Everything else on that sheet - the
' whole L:AE market-data block, plus DelivDate, CTD_ISIN and CTD_CF - is a
' formula fed from BBG_Ticker, and is not ours.
Private Function FuturesOwnedColumns() As Variant

    FuturesOwnedColumns = Array( _
        FCOL_CONTRACTCODE, FCOL_CCY, FCOL_CONTRACTS, FCOL_PORTFOLIO, _
        FCOL_LINKEDISIN, FCOL_STATUS, FCOL_COVERAGE_SOURCEROW, _
        FCOL_COVERAGERELATION, FCOL_FUTURELABEL, FCOL_HEDGETYPE, _
        FCOL_COVERAGE_STARTDATE, FCOL_COVERAGEINFO_D, FCOL_HEDGE_SOURCE, _
        FCOL_COVERAGE_BPV, FCOL_HEDGE_CLASS, FCOL_LINK_SOURCE)

End Function


' Swaps columns this module writes.  The BQL block, the OIS/DF/annuity block
' and the model columns are not here on purpose.
Private Function SwapsOwnedColumns() As Variant

    SwapsOwnedColumns = Array( _
        WCOL_DEALID, WCOL_CCY, WCOL_NOTIONAL, WCOL_STARTDATE, WCOL_ENDDATE, _
        WCOL_PAYFIXED, WCOL_PORTFOLIO, WCOL_FLOATCURVE_TYPE, WCOL_LINKEDISIN, _
        WCOL_CPTY, WCOL_STATUS, WCOL_PNL_SOURCE, WCOL_AF_STATUS, _
        WCOL_BBG_SWAP_DIRECT_ID, WCOL_BBG_FIXED_LEG_ID, WCOL_BBG_FLOAT_LEG_ID, _
        WCOL_SWAP_ID_SOURCE, WCOL_COVERAGERELATION, WCOL_SWAPMAP_SOURCEROW, _
        WCOL_SWAPMAP_CLASS, WCOL_SWAPMAP_STATUS, WCOL_MAP_NOTIONAL, _
        WCOL_MAP_CCY, WCOL_MAP_COUNTERPARTY, WCOL_NOTIONAL_FINAL, _
        WCOL_NOTIONAL_SOURCE, WCOL_LINK_SOURCE)

End Function


' Contract detail this module may fill IN ADDITION, but only into a cell that
' is empty and only where the column is not formula-driven.  See FillSpecIfSafe.
Private Function FuturesSpecColumns() As Variant

    FuturesSpecColumns = Array(FCOL_EXCHANGE, FCOL_FACEVALUE)

End Function


Private Sub ClearOwnedColumns( _
    ByVal ws As Worksheet, _
    ByVal firstRow As Long, _
    ByVal lastRow As Long, _
    ByVal cols As Variant)

    Dim i As Long
    Dim c As String

    If lastRow < firstRow Then Exit Sub

    For i = LBound(cols) To UBound(cols)
        c = CStr(cols(i))
        ws.Range(c & firstRow & ":" & c & lastRow).ClearContents
    Next i

End Sub


' Write the owned columns out of the full-width buffer, one column at a time.
'
' The buffer stays full width because indexing it by colNum() is what keeps the
' assignments readable.  What changed is that only the owned columns are ever
' handed to the sheet.
Private Sub WriteOwnedColumns( _
    ByVal ws As Worksheet, _
    ByVal firstRow As Long, _
    ByVal buf As Variant, _
    ByVal n As Long, _
    ByVal cols As Variant)

    Dim i As Long
    Dim r As Long
    Dim c As Long
    Dim colBuf() As Variant

    If n < 1 Then Exit Sub

    ReDim colBuf(1 To n, 1 To 1)

    For i = LBound(cols) To UBound(cols)

        c = colNum(CStr(cols(i)))

        For r = 1 To n
            colBuf(r, 1) = buf(r, c)
        Next r

        ws.Range(CStr(cols(i)) & firstRow).Resize(n, 1).value = colBuf

    Next i

End Sub


' The last row in a column that currently holds a formula, or 0 if none does.
Private Function LastFormulaRowInColumn( _
    ByVal ws As Worksheet, _
    ByVal col As String, _
    ByVal firstRow As Long, _
    ByVal searchLastRow As Long) As Long

    Dim rg As Range
    Dim area As Range

    If searchLastRow < firstRow Then Exit Function

    On Error Resume Next
    Set rg = ws.Range(col & firstRow & ":" & col & searchLastRow) _
               .SpecialCells(xlCellTypeFormulas)
    On Error GoTo 0

    If rg Is Nothing Then Exit Function

    Set area = rg.Areas(rg.Areas.Count)

    LastFormulaRowInColumn = area.Row + area.rows.Count - 1

End Function


' Extend the sheet's own formulas onto rows the load has just added.
'
' This macro does not author formulas.  It reads the R1C1 form of the formula
' ALREADY in the column - from the last row that has one - and assigns it to
' the rows below that have none.  R1C1 is what makes that safe: relative
' references re-base per row exactly as a fill-down would, and assigning
' .FormulaR1C1 writes the formula and nothing else, so no format travels with
' it the way it would through .Copy.
'
' Rows that already hold a formula are never touched, so a hand-edited
' exception on an existing row survives the load.
Private Sub FillFormulaColumnsDown( _
    ByVal ws As Worksheet, _
    ByVal firstRow As Long, _
    ByVal lastRow As Long, _
    ByVal lastColumn As Long, _
    ByVal ownedCols As Variant)

    Dim c As Long
    Dim colL As String
    Dim lastFml As Long

    If lastRow < firstRow Then Exit Sub

    For c = 1 To lastColumn

        colL = ColLetterFromNumber(c)

        If Not IsOwnedColumn(colL, ownedCols) Then

            lastFml = LastFormulaRowInColumn(ws, colL, firstRow, lastRow)

            If lastFml >= firstRow And lastFml < lastRow Then

                ws.Range(colL & (lastFml + 1) & ":" & colL & lastRow).FormulaR1C1 = _
                    ws.Range(colL & lastFml).FormulaR1C1

            End If

        End If

    Next c

End Sub


Private Function IsOwnedColumn( _
    ByVal col As String, _
    ByVal cols As Variant) As Boolean

    Dim i As Long

    For i = LBound(cols) To UBound(cols)
        If UCase$(CStr(cols(i))) = UCase$(col) Then
            IsOwnedColumn = True
            Exit Function
        End If
    Next i

End Function


' Write a contract-detail value only where doing so cannot destroy anything:
' the cell must be empty, and the column must not be formula-driven on the row
' above.  A column fed by BDP is therefore never written, even when a
' particular cell in it happens to be blank because Bloomberg has not answered.
Private Sub FillSpecIfSafe( _
    ByVal ws As Worksheet, _
    ByVal r As Long, _
    ByVal col As String, _
    ByVal v As Variant, _
    ByVal columnIsFormulaDriven As Boolean)

    If columnIsFormulaDriven Then Exit Sub
    If IsEmpty(v) Then Exit Sub
    If Len(CStr(v)) = 0 Then Exit Sub
    If ws.Cells(r, colNum(col)).HasFormula Then Exit Sub
    If CleanText(ws.Cells(r, colNum(col)).value) <> "" Then Exit Sub

    ws.Cells(r, colNum(col)).value = v

End Sub


Private Function AppendCoverageFuturesRowsToFutures( _
    ByVal wsFut As Worksheet) As Long

    Dim wsMap As Worksheet
    Dim lastMapRow As Long
    Dim mapRow As Long
    Dim n As Long
    Dim buf As Variant
    Dim colCount As Long
    Dim lastFutRow As Long

    Dim linkedISIN As String
    Dim futureLabel As String
    Dim futureCode As String
    Dim hedgeSource As String

    Set wsMap = EnsureCoverageFuturesSheet()

    ' Buffer stays full width so it can be indexed by colNum(); only the owned
    ' columns are ever written out of it.
    colCount = colNum(FCOL_LINK_SOURCE)

    ' Clear as far as a previous, larger run could have reached, so contracts
    ' dropped since then do not survive as stale rows - but ONLY in the columns
    ' this module owns.  The market-data block is left alone.
    lastFutRow = LastFutureDataRow(wsFut)

    ClearOwnedColumns wsFut, DATA_ROW, _
        SheetClearLastRow(wsFut, DATA_ROW, lastFutRow), FuturesOwnedColumns()

    lastMapRow = LastRowInColumn(wsMap, CFCOL_SOURCEROW, DATA_ROW)
    If lastMapRow < DATA_ROW Then Exit Function

    ReDim buf(1 To lastMapRow - DATA_ROW + 1, 1 To colCount)

    For mapRow = DATA_ROW To lastMapRow

        futureCode = CleanText(wsMap.Cells(mapRow, colNum(CFCOL_FUTURECODE)).value)

        If Len(futureCode) > 0 Then

            linkedISIN = UCase$(CleanText(wsMap.Cells(mapRow, colNum(CFCOL_LINKEDISIN)).value))
            futureLabel = CleanText(wsMap.Cells(mapRow, colNum(CFCOL_FUTURELABEL)).value)

            hedgeSource = CleanText(wsMap.Cells(mapRow, colNum(CFCOL_HEDGE_SOURCE)).value)

            ' A row with no source tag predates the two-book split.  Default it
            ' to Tx Juro rather than leaving it blank: blank matches NEITHER
            ' side of the RTJ/RT split, so the row would carry risk no bond can
            ' see.
            If Len(hedgeSource) = 0 Then hedgeSource = HEDGE_SOURCE_RTJ

            n = n + 1

            buf(n, colNum(FCOL_CONTRACTCODE)) = futureCode
            buf(n, colNum(FCOL_CCY)) = CleanText(wsMap.Cells(mapRow, colNum(CFCOL_CCY)).value)
            buf(n, colNum(FCOL_CONTRACTS)) = wsMap.Cells(mapRow, colNum(CFCOL_CONTRACTS)).value
            buf(n, colNum(FCOL_PORTFOLIO)) = CleanText(wsMap.Cells(mapRow, colNum(CFCOL_COVERAGERELATION)).value)
            buf(n, colNum(FCOL_LINKEDISIN)) = linkedISIN
            buf(n, colNum(FCOL_STATUS)) = CleanText(wsMap.Cells(mapRow, colNum(CFCOL_IMPORTSTATUS)).value)
            buf(n, colNum(FCOL_COVERAGE_SOURCEROW)) = wsMap.Cells(mapRow, colNum(CFCOL_SOURCEROW)).value
            buf(n, colNum(FCOL_COVERAGERELATION)) = CleanText(wsMap.Cells(mapRow, colNum(CFCOL_COVERAGERELATION)).value)
            buf(n, colNum(FCOL_FUTURELABEL)) = futureLabel
            buf(n, colNum(FCOL_HEDGETYPE)) = CleanText(wsMap.Cells(mapRow, colNum(CFCOL_HEDGETYPE)).value)
            buf(n, colNum(FCOL_COVERAGE_STARTDATE)) = wsMap.Cells(mapRow, colNum(CFCOL_STARTDATE)).value
            buf(n, colNum(FCOL_COVERAGEINFO_D)) = CleanText(wsMap.Cells(mapRow, colNum(CFCOL_COVERAGEINFO_D)).value)
            buf(n, colNum(FCOL_HEDGE_SOURCE)) = hedgeSource
            buf(n, colNum(FCOL_COVERAGE_BPV)) = wsMap.Cells(mapRow, colNum(CFCOL_BPV)).value
            buf(n, colNum(FCOL_LINK_SOURCE)) = CleanText(wsMap.Cells(mapRow, colNum(CFCOL_LINK_SOURCE)).value)

            ' Hedge_Class.  This column was DECLARED and never written - the
            ' constant had no other reference anywhere in the module - so it
            ' has been blank on every row this loader has ever produced.
            ' PNL_Attribution filters both futures DV01 columns and
            ' Futures_Match_Count on Hedge_Class="RATES", and the Dashboard
            ' splits rates from FX on it too, so a blank column meant every
            ' futures hedge summed to zero no matter what else was right.
            buf(n, colNum(FCOL_HEDGE_CLASS)) = HedgeClassFor( _
                CleanText(wsMap.Cells(mapRow, colNum(CFCOL_HEDGETYPE)).value), _
                futureLabel)

            ' Bonds!FutLink.  The label, not the bare code, so a bond covered by
            ' "OE1 #163" and "OE1 #171" shows both.
            QueueBondLink linkedISIN, futureLabel, True

        End If

    Next mapRow

    If n > 0 Then

        WriteOwnedColumns wsFut, DATA_ROW, buf, n, FuturesOwnedColumns()

        ' Contract detail that used to come from OPICS.  Written only into
        ' cells that are empty on a column that is not formula-driven.
        FillFuturesContractSpec wsFut, DATA_ROW, DATA_ROW + n - 1

        ' Let the sheet's own formulas reach the rows just added.
        FillFormulaColumnsDown wsFut, DATA_ROW, DATA_ROW + n - 1, _
            colNum(FCOL_LINK_SOURCE), FuturesOwnedColumns()

    End If

    AppendCoverageFuturesRowsToFutures = n

End Function


' Which side of the book a futures hedge belongs to.
'
' Both Hedge Risco books are interest-rate books, so RATES is the default and
' an FX hedge has to say so.  The two strings are the ones PNL_Attribution and
' modDashboard already filter on; they are not free text.
Private Function HedgeClassFor( _
    ByVal hedgeType As String, _
    ByVal futureLabel As String) As String

    Dim t As String

    t = UCase$(hedgeType & " " & futureLabel)

    If InStr(t, "FX") > 0 _
       Or InStr(t, "CAMBIAL") > 0 _
       Or InStr(t, "CAMBIO") > 0 _
       Or InStr(t, "CURRENCY") > 0 Then
        HedgeClassFor = HEDGE_CLASS_FX
    Else
        HedgeClassFor = HEDGE_CLASS_RATES
    End If

End Function


Private Function AppendSwapMapRowsToSwaps(ByVal wsSw As Worksheet) As Long

    Dim wsMap As Worksheet
    Dim lastMapRow As Long
    Dim mapRow As Long
    Dim n As Long
    Dim buf As Variant
    Dim colCount As Long
    Dim lastSwRow As Long
    Dim seen As Object

    Dim directId As String
    Dim fixedId As String
    Dim floatId As String
    Dim linkedISIN As String
    Dim coverageRelation As String
    Dim idSource As String
    Dim baseSwapId As String
    Dim mappingRowId As String
    Dim sourceRow As String
    Dim notional As Variant
    Dim ccy As String
    Dim counterparty As String
    Dim curveType As String

    Set wsMap = EnsureSwapMapSheet()
    Set seen = CreateObject("Scripting.Dictionary")

    colCount = colNum(WCOL_LINK_SOURCE)

    lastSwRow = LastSwapDataRow(wsSw)

    ' Owned columns only.  This used to clear A:BP outright, which on the real
    ' sheet took out DV01 BBG, the whole BQL block, OIS, DF, the annuities and
    ' FX along with it.
    ClearOwnedColumns wsSw, DATA_ROW, _
        SheetClearLastRow(wsSw, DATA_ROW, lastSwRow), SwapsOwnedColumns()

    lastMapRow = LastRowInColumn(wsMap, SMCOL_SOURCEROW, DATA_ROW)
    If lastMapRow < DATA_ROW Then Exit Function

    ReDim buf(1 To lastMapRow - DATA_ROW + 1, 1 To colCount)

    For mapRow = DATA_ROW To lastMapRow

        sourceRow = IdText(wsMap.Cells(mapRow, colNum(SMCOL_SOURCEROW)).value)
        coverageRelation = CleanText(wsMap.Cells(mapRow, colNum(SMCOL_COVERAGERELATION)).value)
        linkedISIN = UCase$(CleanText(wsMap.Cells(mapRow, colNum(SMCOL_LINKEDISIN)).value))
        idSource = UCase$(CleanText(wsMap.Cells(mapRow, colNum(SMCOL_SWAP_ID_SOURCE)).value))

        directId = IdText(wsMap.Cells(mapRow, colNum(SMCOL_SWAP_DIRECT_ID)).value)
        fixedId = IdText(wsMap.Cells(mapRow, colNum(SMCOL_FIXED_LEG_ID)).value)
        floatId = IdText(wsMap.Cells(mapRow, colNum(SMCOL_FLOAT_LEG_ID)).value)

        ' Prefer the direct Bloomberg swap id; then the leg pair; then a
        ' traceable source-row id, so a swap with no Bloomberg identity still
        ' gets a row that can be found in the source book.
        If Len(directId) > 0 Then
            baseSwapId = directId
        ElseIf Len(fixedId) > 0 Or Len(floatId) > 0 Then
            baseSwapId = "LEGS_" & fixedId & "_" & floatId
        Else
            baseSwapId = idSource & "_ROW_" & sourceRow
        End If

        ' One swap can hedge several bonds, and one source row can hold both a
        ' plain and a synthetic alternative, so the row id has to carry all
        ' four parts to stay unique.
        mappingRowId = idSource & "|" & baseSwapId & "|" & linkedISIN & "|" & sourceRow

        If Len(linkedISIN) > 0 And Not seen.Exists(mappingRowId) Then

            seen.Add mappingRowId, True

            notional = wsMap.Cells(mapRow, colNum(SMCOL_NOTIONAL)).value
            ccy = CleanText(wsMap.Cells(mapRow, colNum(SMCOL_CCY)).value)
            counterparty = CleanText(wsMap.Cells(mapRow, colNum(SMCOL_COUNTERPARTY)).value)

            n = n + 1

            buf(n, colNum(WCOL_DEALID)) = TextSafe(mappingRowId)
            buf(n, colNum(WCOL_CCY)) = ccy
            buf(n, colNum(WCOL_NOTIONAL)) = notional
            buf(n, colNum(WCOL_STARTDATE)) = wsMap.Cells(mapRow, colNum(SMCOL_STARTDATE)).value
            buf(n, colNum(WCOL_ENDDATE)) = wsMap.Cells(mapRow, colNum(SMCOL_ENDDATE)).value
            buf(n, colNum(WCOL_PORTFOLIO)) = coverageRelation
            buf(n, colNum(WCOL_LINKEDISIN)) = TextSafe(linkedISIN)
            buf(n, colNum(WCOL_CPTY)) = counterparty
            buf(n, colNum(WCOL_STATUS)) = "BQL mapping imported"
            buf(n, colNum(WCOL_PNL_SOURCE)) = "BQL_PENDING"
            buf(n, colNum(WCOL_AF_STATUS)) = "BQL mapping imported"
            buf(n, colNum(WCOL_BBG_SWAP_DIRECT_ID)) = TextSafe(directId)
            buf(n, colNum(WCOL_BBG_FIXED_LEG_ID)) = TextSafe(fixedId)
            buf(n, colNum(WCOL_BBG_FLOAT_LEG_ID)) = TextSafe(floatId)
            buf(n, colNum(WCOL_SWAP_ID_SOURCE)) = idSource
            buf(n, colNum(WCOL_COVERAGERELATION)) = coverageRelation
            buf(n, colNum(WCOL_SWAPMAP_SOURCEROW)) = sourceRow
            buf(n, colNum(WCOL_SWAPMAP_CLASS)) = "SWAP"
            buf(n, colNum(WCOL_SWAPMAP_STATUS)) = _
                CleanText(wsMap.Cells(mapRow, colNum(SMCOL_IMPORTSTATUS)).value)
            buf(n, colNum(WCOL_MAP_NOTIONAL)) = notional
            buf(n, colNum(WCOL_MAP_CCY)) = ccy
            buf(n, colNum(WCOL_MAP_COUNTERPARTY)) = counterparty
            buf(n, colNum(WCOL_NOTIONAL_FINAL)) = Abs(CDblSafe(notional))
            buf(n, colNum(WCOL_NOTIONAL_SOURCE)) = _
                CleanText(wsMap.Cells(mapRow, colNum(SMCOL_NOTIONAL_SOURCE)).value)
            buf(n, colNum(WCOL_LINK_SOURCE)) = _
                CleanText(wsMap.Cells(mapRow, colNum(SMCOL_LINK_SOURCE)).value)

            ' FloatCurve_Type was never written by this module either.
            ' Swap_Curve_Model_PnL switches on it: "ESTR"/"SOFR" take the
            ' risk-free move, "EURIBOR" takes the swap move, and anything the
            ' formula does not recognise contributes ZERO to the model PnL
            ' without saying so.  "UNKNOWN" is the one value it treats as a
            ' question rather than a zero - it blanks the whole cell, which
            ' drops the row out of the headline instead of understating it.
            ' So an undetermined curve is written as UNKNOWN, never left blank.
            curveType = FloatCurveTypeFor(ccy, floatId, directId)
            buf(n, colNum(WCOL_FLOATCURVE_TYPE)) = curveType

            If curveType = "UNKNOWN" Then mUnknownCurveCount = mUnknownCurveCount + 1

            ' PayFixed is deliberately NOT written.  It came only from OPICS,
            ' which this module no longer uses, and there is no pay/receive
            ' column in either coverage book's constants to read it from.  A
            ' guessed sign here flips the hedge, so the cell is left empty and
            ' the gap is reported at the end rather than filled with a coin
            ' flip.  Name the column in the Tx Juro book and it gets read.

            ' Bonds!SwapLink carries the PLAIN swaps only.  A synthetic is an
            ' alternative to the plain swap on the same relation, not a second
            ' hedge, so listing it on the bond row would read as double cover.
            ' Synthetics stay fully mapped in SwapMap, on Swaps, and through
            ' Swaps!LinkedISIN + Swaps!Swap_ID_Source.
            If idSource = "PLAIN" Then
                QueueBondLink linkedISIN, baseSwapId, False
            End If

        End If

    Next mapRow

    If n > 0 Then

        WriteOwnedColumns wsSw, DATA_ROW, buf, n, SwapsOwnedColumns()

        FillFormulaColumnsDown wsSw, DATA_ROW, DATA_ROW + n - 1, _
            colNum(WCOL_LINK_SOURCE), SwapsOwnedColumns()

    End If

    AppendSwapMapRowsToSwaps = n

End Function


' Which curve a swap's floating leg is measured against.
'
' Read from the Bloomberg leg identifiers where they say, then from the
' currency's overnight index as a last resort, and "UNKNOWN" when neither
' settles it.  Returning UNKNOWN is deliberate: Swap_Curve_Model_PnL tests for
' exactly that string and blanks its result, so an unresolved swap removes its
' bond from the headline rather than quietly contributing a zero to it.
Private Function FloatCurveTypeFor( _
    ByVal ccy As String, _
    ByVal floatLegId As String, _
    ByVal directId As String) As String

    Dim t As String

    t = UCase$(floatLegId & " " & directId)

    If InStr(t, "ESTR") > 0 Or InStr(t, "ESTER") > 0 Or InStr(t, "EONIA") > 0 Then
        FloatCurveTypeFor = "ESTR"
    ElseIf InStr(t, "SOFR") > 0 Then
        FloatCurveTypeFor = "SOFR"
    ElseIf InStr(t, "EURIB") > 0 Or InStr(t, "EUR003M") > 0 Or InStr(t, "EUR006M") > 0 Then
        FloatCurveTypeFor = "EURIBOR"
    ElseIf UCase$(Trim$(ccy)) = "USD" Then
        FloatCurveTypeFor = "SOFR"
    Else
        FloatCurveTypeFor = "UNKNOWN"
    End If

End Function


' =============================================================================
' FUTURES CONTRACT SPECIFICATION
'
' This replaces the OPICS block that used to sit here.
'
' What OPICS was actually asked for was small: exchange, face value, delivery
' date, CTD ISIN, CTD conversion factor and average entry price for the futures,
' plus PayFixed for the swaps.  Everything that decides WHICH hedges exist and
' WHAT they cover came, and still comes, from the two Hedge Risco books.
'
' Four of those six fields are already on the sheet as Bloomberg formulas,
' driven off Futures!BBG_Ticker:
'
'     BBG_Ticker    = VLOOKUP(ContractCode, FutMapTable, 2, FALSE)
'     DelivDate     = BDP(ticker, "LAST_TRADEABLE_DT") / "FUT_DLV_DT"
'     CTD_Ticker    -> CTD_DirtyPx_T0, and CTD_ISIN / CTD_CF beside it
'     FUT_VAL_PT    = BDP(ticker, "FUT_VAL_PT")
'     HedgeUnitDV01 = BDP(ticker, "FUT_PX_VAL_BP")
'
' So the database was being asked for numbers the workbook already had a live
' source for.  Writing them from here would also mean writing a VALUE into a
' formula cell, which is the thing this module must not do.
'
' That leaves exchange and face value, which are properties of the CONTRACT
' ROOT and do not change - a Bund future is 100,000 EUR on Eurex whichever
' delivery is front.  They are a table, not a query.
'
' The contract code the coverage books give us is the root only: the label
' "OE1 #163" resolves through FutureCodeFromCoverageLabel to "OE", with no
' delivery month.  That is the correct key for this table, and it is also why
' the delivery date has to come from the ticker rather than from the code.
'
' Values are written through FillSpecIfSafe: empty cell, non-formula column,
' or nothing happens.
'
' TO ADD A CONTRACT: one line below.  An unknown root is not an error - the
' row loads, its two spec cells stay empty, and the Bloomberg chain still
' prices it off the FutMap ticker.
' =============================================================================


Private Sub FillFuturesContractSpec( _
    ByVal wsFut As Worksheet, _
    ByVal firstRow As Long, _
    ByVal lastRow As Long)

    Dim r As Long
    Dim root As String
    Dim spec As Variant
    Dim exchangeIsFormula As Boolean
    Dim faceValueIsFormula As Boolean

    If lastRow < firstRow Then Exit Sub

    ' Decided ONCE per column, from the first data row, rather than per cell.
    ' A column fed by BDP is out of bounds for its whole length, including the
    ' rows where Bloomberg has not answered yet and the cell looks empty.
    exchangeIsFormula = ColumnIsFormulaDriven(wsFut, FCOL_EXCHANGE, firstRow, lastRow)
    faceValueIsFormula = ColumnIsFormulaDriven(wsFut, FCOL_FACEVALUE, firstRow, lastRow)

    If exchangeIsFormula And faceValueIsFormula Then Exit Sub

    For r = firstRow To lastRow

        root = UCase$(CleanText(wsFut.Cells(r, colNum(FCOL_CONTRACTCODE)).value))

        If Len(root) > 0 Then

            spec = FutureSpec(root)

            If Not IsEmpty(spec) Then
                FillSpecIfSafe wsFut, r, FCOL_EXCHANGE, spec(0), exchangeIsFormula
                FillSpecIfSafe wsFut, r, FCOL_FACEVALUE, spec(1), faceValueIsFormula
            End If

        End If

    Next r

End Sub


' Array(Exchange, FaceValue) for a contract root, or Empty if it is not listed.
'
' Face value is the contract's notional in its own currency - the unit the
' desk's DV01 per contract is quoted against - not a EUR amount.
Private Function FutureSpec(ByVal root As String) As Variant

    Select Case UCase$(Trim$(root))

        ' --- Eurex, EUR ---
        Case "DU", "FGBS"          ' Schatz, 2y
            FutureSpec = Array("EUX", 100000)
        Case "OE", "FGBM"          ' Bobl, 5y
            FutureSpec = Array("EUX", 100000)
        Case "RX", "FGBL"          ' Bund, 10y
            FutureSpec = Array("EUX", 100000)
        Case "UB", "FGBX"          ' Buxl, 30y
            FutureSpec = Array("EUX", 100000)
        Case "OAT"                 ' French 10y
            FutureSpec = Array("EUX", 100000)
        Case "IK"                  ' Italian BTP 10y
            FutureSpec = Array("EUX", 100000)
        Case "BTS"                 ' Italian BTP short
            FutureSpec = Array("EUX", 100000)

        ' --- CBOT, USD ---
        Case "TU"                  ' 2y note
            FutureSpec = Array("CBT", 200000)
        Case "FV"                  ' 5y note
            FutureSpec = Array("CBT", 100000)
        Case "TY"                  ' 10y note
            FutureSpec = Array("CBT", 100000)
        Case "UXY"                 ' ultra 10y
            FutureSpec = Array("CBT", 100000)
        Case "US"                  ' classic bond
            FutureSpec = Array("CBT", 100000)
        Case "WN"                  ' ultra bond
            FutureSpec = Array("CBT", 100000)

        ' --- ICE, GBP ---
        Case "G", "R"              ' long gilt
            FutureSpec = Array("ICE", 100000)

        Case Else
            FutureSpec = Empty

    End Select

End Function


' Is this column driven by formulas rather than written values?
'
' Answered from the column as a whole, not from one cell: a BDP column with a
' blank row in it is still a formula column, and writing a value into that
' blank would replace a live query with a frozen number.
Private Function ColumnIsFormulaDriven( _
    ByVal ws As Worksheet, _
    ByVal col As String, _
    ByVal firstRow As Long, _
    ByVal lastRow As Long) As Boolean

    ColumnIsFormulaDriven = _
        (LastFormulaRowInColumn(ws, col, firstRow, lastRow) >= firstRow)

End Function




' =============================================================================
' GENERIC HELPERS
' =============================================================================


' Column letter -> column number, computed rather than asked of a Range.
'
' The staged writes below call this a few thousand times per load; going
' through ThisWorkbook.Worksheets(1).Range(...).Column each time is a COM round
' trip for arithmetic, and it also made a pure string helper depend on the
' first sheet of the workbook still being a worksheet.
Private Function colNum(ByVal colLetters As String) As Long

    Dim i As Long
    Dim n As Long
    Dim ch As Long

    For i = 1 To Len(colLetters)
        ch = Asc(UCase$(Mid$(colLetters, i, 1))) - 64
        If ch < 1 Or ch > 26 Then Exit Function
        n = n * 26 + ch
    Next i

    colNum = n

End Function


Private Function CDblSafe(ByVal v As Variant) As Double
    On Error GoTo Zero
    If IsNull(v) Or v = "" Then CDblSafe = 0 Else CDblSafe = CDbl(v)
    Exit Function
Zero:
    CDblSafe = 0
End Function


Private Function CleanText(ByVal v As Variant) As String
    On Error GoTo Blank
    If IsNull(v) Then Exit Function
    If IsError(v) Then Exit Function
    CleanText = Trim$(CStr(v))
    Exit Function
Blank:
    CleanText = ""
End Function


' An identifier, never in scientific notation.
Private Function IdText(ByVal v As Variant) As String

    If IsError(v) Then Exit Function
    If IsNull(v) Then Exit Function
    If IsEmpty(v) Then Exit Function

    If VarType(v) = vbString Then
        IdText = CleanText(v)
        Exit Function
    End If

    ' Excel or ADO may already have turned a long id into a number.  This
    ' cannot recover digits it has lost, but it stops the display drifting
    ' further into E+ notation.
    If IsNumeric(v) Then
        IdText = Format$(CDbl(v), "0")
        Exit Function
    End If

    IdText = CleanText(v)

End Function


