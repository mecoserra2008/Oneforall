' =============================================================================
' READING THE TWO COVERAGE BOOKS
'
' Values only.  Reading .Value2 rather than copying the range keeps the source
' book's own formulas, links and formatting out of this workbook entirely -
' which also means a load can never import a style change from a file the desk
' did not intend to restyle this workbook with.
'
' Column A's FORMULA text is kept alongside, because in both books the coverage
' relation is often a link into another sheet and the displayed value alone
' cannot say which relation a row belongs to.
'
' Returns "" on success, or the reason it could not read the book.  A failure
' is a partial load, not a dead run: the other book still gets loaded.
' =============================================================================
Private Function CopyCoverageBook( _
    ByVal bookPath As String, _
    ByVal sheetName As String, _
    ByVal firstRow As Long, _
    ByVal lastRow As Long, _
    ByVal lastCol As String, _
    ByVal formulaCol As String, _
    ByVal wsDst As Worksheet) As String

    Dim wbSrc As Workbook
    Dim wsSrc As Worksheet
    Dim wasOpen As Boolean
    Dim arrValues As Variant
    Dim arrFormulaA As Variant
    Dim i As Long
    Dim fileName As String

    On Error GoTo Fail

    fileName = Dir$(bookPath)

    If Len(fileName) = 0 Then
        CopyCoverageBook = "not found: " & bookPath
        Exit Function
    End If

    ' Already open in this Excel instance?  Reuse it rather than opening a
    ' second copy, which Excel refuses anyway.
    On Error Resume Next
    Set wbSrc = Workbooks(fileName)
    On Error GoTo Fail

    If wbSrc Is Nothing Then
        Set wbSrc = Workbooks.Open( _
            fileName:=bookPath, UpdateLinks:=0, ReadOnly:=True)
        wasOpen = False
    Else
        wasOpen = True
    End If

    Set wsSrc = wbSrc.Worksheets(sheetName)

    arrValues = wsSrc.Range( _
        "A" & firstRow & ":" & lastCol & lastRow).Value2

    arrFormulaA = wsSrc.Range("A" & firstRow & ":A" & lastRow).Formula

    wsDst.Range("A" & firstRow & ":" & lastCol & lastRow).Value2 = arrValues

    For i = 1 To UBound(arrFormulaA, 1)
        ' Written text-safe rather than by formatting the column: the formula
        ' text starts with "=" and would otherwise be evaluated.
        wsDst.Cells(firstRow + i - 1, colNum(formulaCol)).value = _
            "'" & CStr(arrFormulaA(i, 1))
    Next i

    If Not wasOpen Then wbSrc.Close SaveChanges:=False

    Exit Function

Fail:

    CopyCoverageBook = "Error " & CStr(Err.Number) & ": " & Err.Description

    ' Never leave a book this procedure opened hanging around after a failure.
    On Error Resume Next
    If Not wbSrc Is Nothing Then
        If Not wasOpen Then wbSrc.Close SaveChanges:=False
    End If
    On Error GoTo 0

End Function


