    LastBondDataRow = LastRowInColumn(ws, BCOL_ISIN, BOND_DATA_ROW)
End Function


Private Function LastFutureDataRow(ByVal ws As Worksheet) As Long
    LastFutureDataRow = LastRowInColumn(ws, FCOL_CONTRACTCODE, DATA_ROW)
End Function


Private Function LastSwapDataRow(ByVal ws As Worksheet) As Long
    LastSwapDataRow = LastRowInColumn(ws, WCOL_DEALID, DATA_ROW)
End Function


' Last non-empty row of `keyCol` at or below `firstDataRow`, or
' firstDataRow - 1 when the sheet holds no data.
Private Function LastRowInColumn( _
    ByVal ws As Worksheet, _
    ByVal keyCol As String, _
    ByVal firstDataRow As Long) As Long

    Dim r As Long

    On Error GoTo Empty_

    r = ws.Cells(ws.rows.Count, colNum(keyCol)).End(xlUp).Row

    If r < firstDataRow Then GoTo Empty_

    LastRowInColumn = r
    Exit Function

Empty_:
    LastRowInColumn = firstDataRow - 1

End Function


' How far a clear must reach.
'
' Deliberately PAST the current data: if yesterday loaded 40 futures and today
' loads 38, rows 39-40 still hold yesterday's positions and must go, or the
' attribution keeps reporting two hedges the desk no longer has.
'
' The lookahead is a FIXED number of rows.  It used to be taken from
' ws.UsedRange, which made the clear as large as whatever the sheet's used
' range had grown to - and the old blanket NumberFormat writes had grown it to
' row 50,004, so every clear became a 50,000-row x 67-column operation.  That
' is what took Excel down when the button was pressed.
Private Function SheetClearLastRow( _
    ByVal ws As Worksheet, _
    ByVal firstDataRow As Long, _
    ByVal lastDataRow As Long) As Long

    Dim n As Long

    n = lastDataRow + CLEAR_LOOKAHEAD_ROWS

    If n < firstDataRow Then n = firstDataRow

    If n > firstDataRow + MAX_SHEET_ROWS - 1 Then
        n = firstDataRow + MAX_SHEET_ROWS - 1
    End If

    SheetClearLastRow = n

End Function


' T1 = last business day, T0 = the one before it.  Only when the desk has not
' pinned the dates by hand.
Private Sub Update_Config_Dates_5pmUTC(ByVal wsCfg As Worksheet)

    Dim t1 As Date
    Dim t0 As Date

    If CleanText(wsCfg.Range(CFG_AUTO_DATE).value) <> "AUTO" Then Exit Sub

    t1 = PrevBusinessDay(Date)
    t0 = PrevBusinessDay(t1)

    wsCfg.Range(CFG_T1_DATE).value = t1
    wsCfg.Range(CFG_T0_DATE).value = t0

End Sub


Private Function PrevBusinessDay(ByVal d As Date) As Date

    Dim x As Date

    x = d - 1

    Do While Weekday(x, vbMonday) >= 6      ' Saturday or Sunday
        x = x - 1
    Loop

    PrevBusinessDay = x

End Function


Private Function CaptureErrInfo() As String
    CaptureErrInfo = "Error " & CStr(Err.Number) & ": " & Err.Description
End Function


' =============================================================================
' LOAD_OPICS_HEDGES  -  the only button in this module
'
' Run order:
'
'   1  read Hedge Risco Tx Juro into its scratch sheet
'   2  index its coverage relations, then build SwapMap and CoverageFutures
'   3  read Hedge Risco Total into its own scratch sheet
'   4  index ITS coverage relations, then append to CoverageFutures
'   5  write the Swaps sheet from SwapMap, the Futures sheet from CoverageFutures
'   6  stamp Bonds!SwapLink / Bonds!FutLink
'   7  enrich from OPICS: PayFixed for the swaps, operational fields for the futures
'
' Step 3 failing is a PARTIAL load, not a dead run: the Tx Juro positions are
' already mapped and are still worth having, so the failure is reported in the
' completion box rather than thrown.
'
' Excel state (calculation, screen updating, events, alerts, link prompts) is
' saved before anything is touched and restored on EVERY exit path, including
' the error one.  The completion box is shown AFTER the restore, so a run can
' never leave the application with events off waiting on a modal dialog.
' =============================================================================


' =============================================================================
' THE BUTTON
'
' Assign a Form Control button to Load_Hedges - NOT to LoadHedges_Step2.
'
' Excel's "Assign Macro" dialog lists only Public Subs that take NO parameters
' at all.  An Optional one still disqualifies a procedure, so
' LoadHedges_Step2(Optional silent As Boolean) and the old LoadOPICS_Hedges
' have never appeared in that list and never will, no matter how many times the
' button is redrawn.  That is why a button could not be attached to this macro.
'
' Load_Hedges takes nothing, so it shows up.
'
' One caution if the button goes on the Dashboard: modDashboard's build deletes
' every shape on that sheet whose name does not start with "btnPnl", so either
' put the button on another sheet or rename it to btnPnlLoadHedges.
' =============================================================================
Public Sub Load_Hedges()
    LoadHedges_Step2 False
End Sub


' Kept as the old name so anything already pointing at it still resolves.
Public Sub LoadOPICS_Hedges(Optional ByVal silent As Boolean = False)
    LoadHedges_Step2 silent
End Sub


' Run the layout check on its own, without loading anything.
'
' Worth pressing after anyone inserts, deletes or renames a column on Futures
' or Swaps.  It reads two header rows and writes nothing at all.
Public Sub Check_Hedge_Layout()

    Dim wb As Workbook
    Dim bad As String

    On Error GoTo CheckFail

    Set wb = ThisWorkbook

    bad = AssertHedgeSheetHeaders( _
        RequireSheet(wb, SH_FUTURES), RequireSheet(wb, SH_SWAPS))

    If Len(bad) = 0 Then
        MsgBox SH_FUTURES & " and " & SH_SWAPS & " match the layout this " & _
            "macro compiles against." & vbCrLf & vbCrLf & _
            "42 futures columns and 78 swap columns, all in place.", _
            vbInformation, "Hedge layout OK"
    Else
        MsgBox bad, vbExclamation, "Hedge layout has moved"
    End If

    Exit Sub

CheckFail:

    MsgBox "Could not check the layout." & vbCrLf & vbCrLf & CaptureErrInfo(), _
        vbCritical, "Hedge layout check failed"

End Sub


Public Sub LoadHedges_Step2(Optional ByVal silent As Boolean = False)

    Dim wb As Workbook
    Dim wsCfg As Worksheet
    Dim wsBnd As Worksheet
    Dim wsSw As Worksheet
    Dim wsFut As Worksheet
    Dim wsCov As Worksheet
    Dim wsCovTotal As Worksheet

    Dim oldCalc As XlCalculation
    Dim oldScreen As Boolean
    Dim oldEvents As Boolean
    Dim oldAlerts As Boolean
    Dim oldAskLinks As Boolean
    Dim stateSaved As Boolean

    Dim rcByRow As Object
    Dim rcIndex As Object

    Dim swapCount As Long
    Dim futCount As Long
    Dim mappedSwapCount As Long
    Dim mappedFutureCount As Long
    Dim totalFutureCount As Long

    Dim txJuroError As String
    Dim totalBookError As String
    Dim failureMessage As String


    On Error GoTo HedgeErr

    Set wb = ThisWorkbook

    ' Named explicitly so a missing sheet says WHICH one, rather than failing
    ' as an anonymous subscript error inside the first thing that touches it.
    Set wsCfg = RequireSheet(wb, SH_CONFIG)
    Set wsBnd = RequireSheet(wb, SH_BONDS)
    Set wsSw = RequireSheet(wb, SH_SWAPS)
    Set wsFut = RequireSheet(wb, SH_FUTURES)

    oldCalc = Application.Calculation
    oldScreen = Application.ScreenUpdating
    oldEvents = Application.EnableEvents
    oldAlerts = Application.DisplayAlerts
    oldAskLinks = Application.AskToUpdateLinks
    stateSaved = True

    Application.Calculation = xlCalculationManual
    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.DisplayAlerts = False
    Application.AskToUpdateLinks = False

    Application.StatusBar = "Load hedges: preparing..."

    mUnknownCurveCount = 0

    Update_Config_Dates_5pmUTC wsCfg

    ' The layout check runs FIRST, ahead of every read and every write.
    '
    ' Every column this module touches is addressed by letter.  If the sheet
    ' has been re-laid out underneath those letters - which is exactly what
    ' happened when Swaps gained ten columns at O - the load does not fail, it
    ' succeeds against the wrong cells: hedge text over market data, and an
    ' attribution that quietly reports a fully hedged book as unhedged.
    ' Stopping here is the difference between a message and a wrong number.
    failureMessage = AssertHedgeSheetHeaders(wsFut, wsSw)
    If Len(failureMessage) > 0 Then GoTo CleanExit

    If CleanText(wsBnd.Cells(BOND_DATA_ROW, colNum(BCOL_ISIN)).value) = "" Then
        failureMessage = "No bonds loaded on the " & SH_BONDS & " sheet." & vbCrLf & _
                         "Load the bonds first - there is nothing to attach a hedge to."
        GoTo CleanExit
    End If

    ' =========================================================================
    ' BOOK 1: HEDGE RISCO TX JURO
    ' =========================================================================
    Application.StatusBar = "Load hedges: reading Hedge Risco Tx Juro..."

    Set wsCov = EnsureCoverageSupportSheet()

    ClearCoverageSupportSheet

    txJuroError = CopyCoverageBook( _
        SWAP_ID_BOOK_PATH, SWAP_ID_BOOK_SHEET, _
        SWAP_ID_FIRST_ROW, SWAP_ID_LAST_ROW, _
        HEDGE_RISCO_COPY_LAST_COL, HEDGE_RISCO_FORMULA_A_COL, wsCov)

    ' Book 1 failing STOPS the run, before anything is rewritten.
    '
    ' It is the book that owns the swaps and most of the futures, so carrying
    ' on would clear the Swaps and Futures sheets and refill them from an empty
    ' map - the desk would lose every hedge because a mapped drive blipped.
    ' Book 2 failing is different, and is handled as a partial load below.
    If Len(txJuroError) > 0 Then
        failureMessage = "Hedge Risco Tx Juro could not be read, so nothing was " & _
            "changed:" & vbCrLf & vbCrLf & txJuroError & vbCrLf & vbCrLf & _
            "The " & SH_SWAPS & " and " & SH_FUTURES & " sheets are exactly as " & _
            "they were."
        GoTo CleanExit
    End If

    Application.StatusBar = "Load hedges: indexing Tx Juro coverage relations..."

    ' Built ONCE and shared by the swap and futures passes, so the two cannot
    ' disagree about which relation a row belongs to.
    Set rcByRow = BuildCoverageRelationByRow( _
        wsCov, SWAP_ID_FIRST_ROW, SWAP_ID_LAST_ROW, _
        RTJ_RC_COL, HEDGE_RISCO_FORMULA_A_COL, HEDGE_RISCO_COPY_LAST_COL)

    Set rcIndex = BuildCoverageRelationIndex( _
        wsCov, SWAP_ID_FIRST_ROW, SWAP_ID_LAST_ROW, RTJ_ISIN_COL, rcByRow)

    Application.StatusBar = "Load hedges: building SwapMap..."
    mappedSwapCount = BuildSwapMapFromCoverageSupport(rcByRow, rcIndex)

    ' This also CLEARS CoverageFutures, which is why it must run before the
    ' Total pass appends to it: without it the Total rows would pile up under
    ' yesterday's Tx Juro rows on every run.
    Application.StatusBar = "Load hedges: building CoverageFutures..."
    mappedFutureCount = BuildCoverageFuturesMapFromCoverageSupport(rcByRow, rcIndex)

    ClearCoverageSupportSheet

    ' =========================================================================
    ' BOOK 2: HEDGE RISCO TOTAL
    '
    ' Its own scan, its own columns, its own #RC index.  The two books number
    ' their relations independently, so nothing from book 1 is in scope here.
    ' =========================================================================
    Application.StatusBar = "Load hedges: reading Hedge Risco Total..."

    Set wsCovTotal = EnsureCoverageTotalSupportSheet()

    ClearCoverageTotalSupportSheet

    totalBookError = CopyCoverageBook( _
        HEDGE_TOTAL_BOOK_PATH, HEDGE_TOTAL_BOOK_SHEET, _
        HEDGE_TOTAL_FIRST_ROW, HEDGE_TOTAL_LAST_ROW, _
        HEDGE_TOTAL_COPY_LAST_COL, HEDGE_TOTAL_FORMULA_A_COL, wsCovTotal)

    If Len(totalBookError) = 0 Then

        Application.StatusBar = "Load hedges: indexing Total coverage relations..."

        Set rcByRow = BuildCoverageRelationByRow( _
            wsCovTotal, HEDGE_TOTAL_FIRST_ROW, HEDGE_TOTAL_LAST_ROW, _
            RT_RC_COL, HEDGE_TOTAL_FORMULA_A_COL, HEDGE_TOTAL_COPY_LAST_COL)

        Set rcIndex = BuildCoverageRelationIndex( _
            wsCovTotal, HEDGE_TOTAL_FIRST_ROW, HEDGE_TOTAL_LAST_ROW, _
            RT_ISIN_COL, rcByRow)

        Application.StatusBar = "Load hedges: appending Total futures..."
        totalFutureCount = AppendCoverageFuturesMapFromCoverageTotal(rcByRow, rcIndex)

    End If

    ClearCoverageTotalSupportSheet

    mappedFutureCount = mappedFutureCount + totalFutureCount

    ' =========================================================================
    ' WRITE THE HEDGE SHEETS
    '
    ' Nothing above this point has changed Bonds, Swaps or Futures.  Every way
    ' the run can stop early - no bonds, no ISIN type, book 1 unreachable -
    ' therefore leaves all three exactly as they were, which is what makes
    ' "nothing was changed" in the message true rather than nearly true.
    ' =========================================================================
    Application.StatusBar = "Load hedges: writing Swaps..."

    ' Index the bonds and clear their two link columns, at the moment the
    ' rebuild actually starts.  The header row was checked at the top of the
    ' run and is not written to.
    BeginBondLinks wsBnd

    swapCount = AppendSwapMapRowsToSwaps(wsSw)

    Application.StatusBar = "Load hedges: writing Futures..."
    futCount = AppendCoverageFuturesRowsToFutures(wsFut)

    Application.StatusBar = "Load hedges: writing bond coverage links..."
    FlushBondLinks wsBnd

    ' The OPICS enrichment pass used to run here.  It is gone: what it filled
    ' in is either already a Bloomberg formula on the Futures sheet or a
    ' property of the contract root, and both are handled inside the futures
    ' append itself.  See "FUTURES CONTRACT SPECIFICATION" above.

    wsCfg.Range(CFG_SWAP_CNT).value = swapCount
    wsCfg.Range(CFG_FUT_CNT).value = futCount

CleanExit:

    On Error Resume Next

    ClearCoverageSupportSheet
    ClearCoverageTotalSupportSheet

    If stateSaved Then
        Application.Calculation = oldCalc
        Application.ScreenUpdating = oldScreen
        Application.EnableEvents = oldEvents
        Application.DisplayAlerts = oldAlerts
        Application.AskToUpdateLinks = oldAskLinks
    End If

    Application.StatusBar = False

    On Error GoTo 0

    ' Reported only after Excel is back to normal, so a modal box can never be
    ' waiting while events and screen updating are still switched off.
    If Not silent Then

        If Len(failureMessage) > 0 Then

            MsgBox failureMessage, vbExclamation, "Load hedges - nothing loaded"

        Else

            MsgBox HedgeLoadReport( _
                swapCount, futCount, mappedSwapCount, mappedFutureCount, _
                totalFutureCount, txJuroError, totalBookError), _
                HedgeLoadIcon(txJuroError, totalBookError), _
                "Load hedges complete"

        End If

    End If

    Exit Sub

HedgeErr:

    failureMessage = "The hedge load stopped." & vbCrLf & vbCrLf & CaptureErrInfo()

    On Error Resume Next

    ClearCoverageSupportSheet
    ClearCoverageTotalSupportSheet

    If stateSaved Then
        Application.Calculation = oldCalc
        Application.ScreenUpdating = oldScreen
        Application.EnableEvents = oldEvents
        Application.DisplayAlerts = oldAlerts
        Application.AskToUpdateLinks = oldAskLinks
    End If

    Application.StatusBar = False

    On Error GoTo 0

    If Not silent Then
        MsgBox failureMessage, vbCritical, "Load hedges failed"
    End If

End Sub


Private Function RequireSheet( _
    ByVal wb As Workbook, _
    ByVal sheetName As String) As Worksheet

    Dim ws As Worksheet

    On Error Resume Next
    Set ws = wb.Worksheets(sheetName)
    On Error GoTo 0

    If ws Is Nothing Then
        Err.Raise 9800, "LoadOPICS_Hedges", _
            "Required sheet not found: " & sheetName
    End If

    Set RequireSheet = ws

End Function


' What the desk needs to know afterwards.
'
' The two books are reported SEPARATELY, and so are the bond link counts.  A
' run where one book was unreachable still loads every position from the other,
' so the only way to notice is a count that says so - and "22 futures rows
' loaded" with "0 bonds linked" is a completely different outcome from the same
' sentence with "18 bonds linked", which the old single total could not show.
Private Function HedgeLoadReport( _
    ByVal swapCount As Long, _
    ByVal futCount As Long, _
    ByVal mappedSwapCount As Long, _
    ByVal mappedFutureCount As Long, _
    ByVal totalFutureCount As Long, _
    ByVal txJuroError As String, _
    ByVal totalBookError As String) As String

    Dim s As String

    s = CStr(swapCount) & " swap rows written to " & SH_SWAPS & "." & vbCrLf & _
        CStr(futCount) & " futures rows written to " & SH_FUTURES & "." & vbCrLf & vbCrLf

    s = s & "SwapMap rows: " & CStr(mappedSwapCount) & vbCrLf
    s = s & "CoverageFutures rows: " & CStr(mappedFutureCount) & _
        "  (Hedge Risco Total: " & CStr(totalFutureCount) & ")" & vbCrLf & vbCrLf

    s = s & "Bonds with a swap link: " & CStr(BondLinkCount(False)) & vbCrLf
    s = s & "Bonds with a futures link: " & CStr(BondLinkCount(True)) & vbCrLf & vbCrLf

    If Len(txJuroError) > 0 Then
        s = s & "Hedge Risco Tx Juro NOT loaded: " & txJuroError & vbCrLf
    End If

    If Len(totalBookError) > 0 Then
        s = s & "Hedge Risco Total NOT loaded: " & totalBookError & vbCrLf
    End If

    If Len(txJuroError) > 0 Or Len(totalBookError) > 0 Then s = s & vbCrLf

    ' The two gaps left by dropping OPICS.  Stated plainly rather than left
    ' for the desk to find as a zero somewhere downstream.
    If mUnknownCurveCount > 0 Then
        s = s & CStr(mUnknownCurveCount) & " swap rows have FloatCurve_Type " & _
            "UNKNOWN." & vbCrLf & _
            "Swap_Curve_Model_PnL blanks those rows rather than guessing," & vbCrLf & _
            "so their bonds drop out of the headline until the curve is set." & _
            vbCrLf & vbCrLf
    End If

    If swapCount > 0 Then
        s = s & "PayFixed was not written - it came from OPICS and neither" & vbCrLf & _
            "coverage book carries a pay/receive column yet." & vbCrLf & vbCrLf
    End If

    s = s & "Check Link_Source on " & SH_FUTURES & " and " & SH_SWAPS & _
        " to see how each" & vbCrLf & _
        "row's bond was resolved: RC means the coverage relation decided it."

    HedgeLoadReport = s

End Function


Private Function HedgeLoadIcon( _
    ByVal txJuroError As String, _
    ByVal totalBookError As String) As Long

    If Len(txJuroError) > 0 Or Len(totalBookError) > 0 Then
        HedgeLoadIcon = vbExclamation
    Else
        HedgeLoadIcon = vbInformation
    End If

End Function
