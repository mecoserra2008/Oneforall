    buf(n, colNum(SMCOL_IMPORTSTATUS)) = statusText
    buf(n, colNum(SMCOL_COUNTERPARTY)) = counterparty
    buf(n, colNum(SMCOL_NOTIONAL)) = notional
    buf(n, colNum(SMCOL_STARTDATE)) = startDate
    buf(n, colNum(SMCOL_ENDDATE)) = endDate
    buf(n, colNum(SMCOL_CCY)) = ccy
    buf(n, colNum(SMCOL_NOTIONAL_SOURCE)) = notionalSource
    buf(n, colNum(SMCOL_RC_KEY)) = rcKey
    buf(n, colNum(SMCOL_LINK_SOURCE)) = linkSource

